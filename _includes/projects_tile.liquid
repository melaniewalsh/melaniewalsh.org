{%- comment -%}
  Square project tile: project image, thick border in the category colour,
  title along the bottom, description revealed on hover/focus.
{%- endcomment -%}
{% assign tile_category = project.category | default: 'work' %}
<div class="col">
  <a
    class="project-tile-link"
    href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}"
    title="{{ project.title | strip_html }}"
  >
    <div class="project-tile project-tile-{{ tile_category }}">
      <span class="project-tile-media">
        {% if project.img %}
          {% if project.img contains '://' %}
            <img src="{{ project.img }}" alt="{{ project.title | strip_html }}" loading="lazy">
          {% else %}
            <img src="{{ project.img | relative_url }}" alt="{{ project.title | strip_html }}" loading="lazy">
          {% endif %}
        {% endif %}
      </span>
      <span class="project-tile-title">{{ project.title }}</span>
      {% if project.description %}
        <span class="project-tile-desc"><span>{{ project.description | strip_html }}</span></span>
      {% endif %}
    </div>
  </a>
</div>
